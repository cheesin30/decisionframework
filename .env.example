# Copy this file to .env and fill in your Alpaca keys.
# Paper keys come from https://app.alpaca.markets (Paper Trading dashboard).
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# true = paper trading endpoint (default). Set to false for live trading.
ALPACA_PAPER=true

# Stock market data feed: iex (free plan) or sip (paid subscription).
STOCK_DATA_FEED=iex

# Where trades.csv / daily_pnl.csv / bot.log are written (default: project root).
# LOG_DIR=.
